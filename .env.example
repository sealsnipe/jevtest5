# Nie committen. Für lokale Tests reicht die Umgebungsvariable in der Shell.
# relay/app.py lädt diese Datei automatisch (python-dotenv).
OPENROUTER_API_KEY=sk-or-...

# --- Relay (relay/app.py) ---
# Frei gewählter Secret-String, beim Setzen des Telegram-Webhooks als secret_token mitgeben:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<relay>/telegram&secret_token=<SECRET>
TELEGRAM_WEBHOOK_SECRET=
# URL + Bearer-Key der Grok-Bot-Routine "Empfang" (Runbook Schritt 6)
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
# Telegram chat_id des Chefs: Nachrichten von dort (Freigaben, Anweisungen) gehen immer durch, ohne Türsteher
CHEF_CHAT_ID=
# optional: Log-Verzeichnis (Default: ./log)
# RELAY_LOG_DIR=
